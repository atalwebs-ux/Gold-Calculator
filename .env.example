# =================================================================
# Global Gold Live - Backend Production Environment Variables
# =================================================================
# Copy this file to .env and fill in your actual credentials.
# On cloud hosting (Render, Railway, Hostinger), set these in the dashboard.

# Server Configuration
NODE_ENV=production
PORT=5000

# Database URL (MySQL 8+)
# Hostinger Format: mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>
DATABASE_URL="mysql://u785941294_gold_db:YOUR_PASSWORD@srv671.hstgr.io:3306/u785941294_gold"

# fastFOREX Live Exchange Rate API
FASTFOREX_API_KEY=YOUR_FASTFOREX_API_KEY
FASTFOREX_BASE_URL=https://api.fastforex.io
FASTFOREX_CACHE_TTL_MS=60000

# Gold API Provider (Optional fallback)
GOLD_API_PROVIDER=goldprice-dev
GOLD_API_BASE_URL=https://api.goldprice.dev/v1
GOLD_API_KEY=
GOLD_API_REFRESH_INTERVAL=60000

# Firebase Admin SDK (For Push Notification Broadcasting & Auth verification)
FIREBASE_PROJECT_ID=gold-calculator-b1036
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Security & CORS
CORS_ORIGIN=*
